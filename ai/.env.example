# Скопируйте в .env (он в .gitignore) и подставьте свой ключ
OPENROUTER_API_KEY=sk-or-v1-...

# Модели по порядку приоритета (через запятую): при сбое берётся следующая.
# Список бесплатных моделей: python ai/eval/list_free_models.py
# "openrouter/free" выбирает случайную бесплатную модель — оставьте её последней.
OPENROUTER_MODELS=openrouter/free
